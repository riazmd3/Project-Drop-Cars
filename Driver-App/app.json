{
  "expo": {
    "name": "Drop Cars-Driver App",
    "slug": "dropcars3",
    "version": "1.0.1",
    "icon": "./assets/logo_icon.png",
    "splash": {
      "image": "./assets/logo_icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a1a2e"
    },
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["notification_tone.wav"],
          "defaultChannel": "dropcars-custom-sound-v2",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31f4ffee-37b4-4db6-a102-1cd99bd74f8e"
      }
    },
    "android": {
      "package": "com.dropcars.driverapp",
      "googleServicesFile": "./assets/google-services.json",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/31f4ffee-37b4-4db6-a102-1cd99bd74f8e"
    },
    "owner": "dropcars",
    "ios": {}
  }
}
